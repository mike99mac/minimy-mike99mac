[Unit]
Description=Piper Text-to-Speech Server (Raspberry Pi)
After=network.target

[Service]
ExecStart={{BASE_DIR}}/minimy_venv/bin/piper --model en_US-hfc_male-medium --http-server --port 5004
WorkingDirectory={{BASE_DIR}}
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH={{BASE_DIR}}:$PYTHONPATH
Environment=SVA_BASE_DIR={{BASE_DIR}}
StandardOutput=append:{{BASE_DIR}}/logs/piper.log
StandardError=append:{{BASE_DIR}}/logs/piper.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
