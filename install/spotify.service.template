[Unit]
Description=go-librespot Spotify Connect receiver
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service

[Service]
WorkingDirectory={{BASE_DIR}}
ExecStartPre=/usr/bin/touch {{BASE_DIR}}/logs/spotify.log
ExecStart=/usr/local/bin/go-librespot --config_dir {{HOME}}/.config/go-librespot
StandardOutput=append:{{BASE_DIR}}/logs/spotify.log
StandardError=append:{{BASE_DIR}}/logs/spotify.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
