[Unit]
Description=Piper Text-to-Speech Server (Jetson)
After=network.target

[Service]
ExecStart=/usr/local/bin/piper --model en_US-hfc_male-medium --http-server --port 5004 --cuda
WorkingDirectory={{BASE_DIR}}
Environment=SVA_BASE_DIR={{BASE_DIR}}
StandardOutput=append:{{BASE_DIR}}/logs/piper.log
StandardError=append:{{BASE_DIR}}/logs/piper.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
